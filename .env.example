# Copy this file to ".env" and fill in your own values. The real .env is git-ignored.
# Get CIC_COOKIE from Chrome DevTools -> Network -> browse.php -> Request Headers -> Cookie.
CIC_COOKIE=Token=your_token_here

# Optional: path to your local dataset folder (defaults to C:\ece597-data).
# ECE597_DATA=C:\ece597-data
